# ─── Google Sheets (ฐานข้อมูลของแดชบอร์ด) ──────────────────────────────────
# ไฟล์ชีตหลัก — มีแท็บ "Registration" (ข้อมูลผู้ใช้ + ตำบล) และ "submission" (ประวัติขยะ)
# https://docs.google.com/spreadsheets/d/1vvBe_ZySfSq4oP8tfwHDUg-Jo3gBr9QanQWqLATAkNE/edit
REGISTRATION_SHEETS_ID=1vvBe_ZySfSq4oP8tfwHDUg-Jo3gBr9QanQWqLATAkNE

# ไฟล์ที่เก็บประวัติขยะ — ตั้งเมื่อแยกออกไปคนละไฟล์กับ Registration
# ถ้าเว้นว่างจะใช้ REGISTRATION_SHEETS_ID (ปัจจุบันอยู่ไฟล์เดียวกัน)
POINTS_SPREADSHEET_ID=

# ชื่อแท็บที่เก็บประวัติขยะ (ค่าเริ่มต้น: submission)
WASTE_SUBMISSION_TAB=submission

# API key ของ Google Sheets API v4 — ใส่ก็ต่อเมื่อต้องการเลี่ยงลิมิตของ endpoint สาธารณะ
# ถ้าเว้นว่าง แอปจะอ่านผ่าน gviz endpoint สาธารณะ ซึ่งใช้ได้กับชีตที่แชร์แบบ "ผู้ที่มีลิงก์"
# สร้างที่ https://console.cloud.google.com/apis/credentials (เปิดใช้ Google Sheets API ก่อน)
GOOGLE_SHEETS_API_KEY=

# ─── LINE LIFF (ล็อกอินผ่าน LINE) ───────────────────────────────────────────
NEXT_PUBLIC_LIFF_ID=
