# ─── Google Sheets (ฐานข้อมูลของแดชบอร์ด) ──────────────────────────────────
# ไฟล์ชีตหลัก — มีแท็บ "Registration" (ข้อมูลผู้ใช้ + ตำบล) และ "submission" (ประวัติขยะ)
# https://docs.google.com/spreadsheets/d/1vvBe_ZySfSq4oP8tfwHDUg-Jo3gBr9QanQWqLATAkNE/edit
REGISTRATION_SHEETS_ID=1vvBe_ZySfSq4oP8tfwHDUg-Jo3gBr9QanQWqLATAkNE

# ⚠️ เลิกใช้แล้ว — โค้ดไม่อ่านค่านี้อีกต่อไป
# แท็บ "submission" อยู่ในไฟล์เดียวกับ Registration เสมอ ถ้ายังตั้งค่านี้ค้างไว้
# (เช่นชี้ไปไฟล์ points) แดชบอร์ดจะอ่านผิดไฟล์แล้วพัง — ให้ลบตัวแปรนี้ทิ้งใน Vercel
# POINTS_SPREADSHEET_ID=

# ชื่อแท็บที่เก็บประวัติขยะ (ค่าเริ่มต้น: submission)
WASTE_SUBMISSION_TAB=submission

# API key ของ Google Sheets API v4 — ใส่ก็ต่อเมื่อต้องการเลี่ยงลิมิตของ endpoint สาธารณะ
# ถ้าเว้นว่าง แอปจะอ่านผ่าน gviz endpoint สาธารณะ ซึ่งใช้ได้กับชีตที่แชร์แบบ "ผู้ที่มีลิงก์"
# สร้างที่ https://console.cloud.google.com/apis/credentials (เปิดใช้ Google Sheets API ก่อน)
GOOGLE_SHEETS_API_KEY=

# ─── Supabase (ฐานข้อมูลหลังบ้านของหน้าแอดมิน) ─────────────────────────────
# หน้าแอดมินอ่านข้อมูลจาก Supabase schema `app`; ระบบบัญชีแดชบอร์ดใช้ schema `dashboard` ของโปรเจกต์เดียวกัน
# ใช้โปรเจกต์เดียวกับแอปจัดการขยะ — คัดลอกค่าจาก .env.local ของแอปนั้น หรือดูที่ Project Settings → API Keys
# ต้องเพิ่ม schema `app` ใน Project Settings → Data API → Exposed schemas ก่อน
# เช่น https://xxxx.supabase.co
SUPABASE_URL=
# secret key (sb_secret_...) หรือ service_role key แบบเดิม — เป็นความลับ ใช้ฝั่งเซิร์ฟเวอร์เท่านั้น ห้ามขึ้นต้นด้วย NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
# (ไม่บังคับ) ชื่อ schema ค่าเริ่มต้น app
SUPABASE_DB_SCHEMA=app

# ─── ระบบบัญชีแดชบอร์ด (Supabase Auth + schema `dashboard`) ────────────────
# บัญชีแดชบอร์ดแยกจากผู้ใช้ LINE ของแอปจัดการขยะ — ตั้งค่าครั้งเดียวตามลำดับนี้ (ชื่อเมนู Supabase อาจต่างเล็กน้อยตามเวอร์ชัน):
#   1) Supabase → SQL Editor: รัน supabase/dashboard_schema.sql แล้วรัน supabase/dashboard_schema_checks.sql (ต้องไม่มี error ที่ขึ้นต้นด้วย FAIL)
#   2) Project Settings → Data API → Exposed schemas: เพิ่ม `dashboard` แล้วกด Save
#   3) Authentication → Sign In / Providers → User Signups: ปิด "Allow new users to sign up"
#      (มีผลทั้งโปรเจกต์ — แอปจัดการขยะล็อกอินด้วย LINE ไม่ได้ใช้ Supabase Auth จึงไม่กระทบ; การสมัครผ่านแดชบอร์ดยังใช้ได้เพราะเซิร์ฟเวอร์ใช้ secret key)
#   4) ตั้งตัวแปรในไฟล์นี้ให้ครบ ทั้งใน .env.local และ Vercel → Settings → Environment Variables แล้ว Redeploy
#   5) pnpm run create-root-admin you@example.com  (root admin คนแรก — ได้รับอีเมลแจ้งผู้สมัครใหม่; พิมพ์รหัสผ่านชั่วคราวให้ครั้งเดียว)
#   ย้าย root ภายหลัง: pnpm run transfer-root new-root@example.com
# แนะนำ: ตั้ง rate limit ที่ Vercel (กันสคริปต์ยิงล็อกอิน/สมัคร/ลืมรหัสผ่านรัว ๆ) — ใช้ได้ทุกแพลน (Hobby ได้ 1 กฎต่อโปรเจกต์)
#   Project → Firewall → Configure → + New Rule:
#     If: Request Path "starts with" /api/auth/  AND  Method "equals" POST
#     Then: Rate Limit → Fixed Window, Time Window 60s, Request Limit 10, Key: IP, Action: Default (429)
#   Save Rule → Review Changes → Publish  (ถ้าพนักงานหลายคนใช้ IP เดียวกันแล้วโดนบล็อก ให้เพิ่ม Request Limit)
# คีย์เซ็น cookie เซสชันและลิงก์ในอีเมล (อย่างน้อย 32 ตัวอักษร) สร้างด้วย: openssl rand -base64 48
# ใช้ค่าคนละค่าระหว่างเครื่องตัวเองกับ production; เปลี่ยนค่านี้ = ทุกคนต้องล็อกอินใหม่ และลิงก์ในอีเมลที่ส่งไปแล้วใช้ไม่ได้
DASHBOARD_SESSION_SECRET=
# URL ของแดชบอร์ด ใช้สร้างลิงก์ในอีเมล (ไม่มี / ท้าย) — บน production ต้องตั้ง
# ในเครื่อง: http://localhost:3000   production: เช่น https://your-dashboard.vercel.app
APP_BASE_URL=

# ─── อีเมล (Gmail SMTP) ──────────────────────────────────────────────────────
# ถ้าเว้นว่าง ระบบยังทำงานได้แต่จะไม่ส่งอีเมล (สมัคร/อนุมัติ/ลืมรหัสผ่าน) — หน้าสมัครจะขึ้น "ส่งอีเมลยืนยันไม่สำเร็จ"
# อีเมล Gmail เต็มของบัญชีที่ใช้ส่ง เช่น info.learndo@gmail.com (ไม่ใช่ชื่อที่ตั้งให้ App password)
GMAIL_USER=
# App password 16 ตัวของบัญชีข้างบน (ใส่ติดกัน ไม่ต้องมีช่องว่าง) สร้างได้ดังนี้:
#   1) เปิด 2-Step Verification ก่อน: https://myaccount.google.com/signinoptions/twosv
#   2) สร้างที่ https://myaccount.google.com/apppasswords (ตั้งชื่ออะไรก็ได้ เช่น dashboard)
# ถ้าขึ้น "The setting you are looking for is not available for your account":
#   ยังไม่ได้เปิด 2-Step Verification, เป็นบัญชี Google Workspace ที่แอดมินปิดไว้ หรืออยู่ใน Advanced Protection
#   → ใช้บัญชี @gmail.com ธรรมดาที่เปิด 2-Step Verification แทน
GMAIL_APP_PASSWORD=

# ─── ตัวแปรที่เลิกใช้แล้ว ─────────────────────────────────────────────────────
# ระบบล็อกอินเดิม (รหัสผ่านกลาง / LINE / บัญชีจำลอง) ถูกแทนด้วยบัญชีแดชบอร์ดแล้ว — ลบตัวแปรเหล่านี้ออกจาก Vercel และ .env.local:
# ADMIN_PASSWORD, ADMIN_SESSION_SECRET, ADMIN_API_ALLOW_UNAUTHENTICATED, NEXT_PUBLIC_LIFF_ID
