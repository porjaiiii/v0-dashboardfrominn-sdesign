# ─── Google Sheets (ฐานข้อมูลของแดชบอร์ด) ──────────────────────────────────
# ไฟล์ชีตหลัก — มีแท็บ "Registration" (ข้อมูลผู้ใช้ + ตำบล) และ "submission" (ประวัติขยะ)
# https://docs.google.com/spreadsheets/d/1vvBe_ZySfSq4oP8tfwHDUg-Jo3gBr9QanQWqLATAkNE/edit
REGISTRATION_SHEETS_ID=1vvBe_ZySfSq4oP8tfwHDUg-Jo3gBr9QanQWqLATAkNE

# ⚠️ เลิกใช้แล้ว — โค้ดไม่อ่านค่านี้อีกต่อไป
# แท็บ "submission" อยู่ในไฟล์เดียวกับ Registration เสมอ ถ้ายังตั้งค่านี้ค้างไว้
# (เช่นชี้ไปไฟล์ points) แดชบอร์ดจะอ่านผิดไฟล์แล้วพัง — ให้ลบตัวแปรนี้ทิ้งใน Vercel
# POINTS_SPREADSHEET_ID=

# ชื่อแท็บที่เก็บประวัติขยะ (ค่าเริ่มต้น: submission)
WASTE_SUBMISSION_TAB=submission

# API key ของ Google Sheets API v4 — ใส่ก็ต่อเมื่อต้องการเลี่ยงลิมิตของ endpoint สาธารณะ
# ถ้าเว้นว่าง แอปจะอ่านผ่าน gviz endpoint สาธารณะ ซึ่งใช้ได้กับชีตที่แชร์แบบ "ผู้ที่มีลิงก์"
# สร้างที่ https://console.cloud.google.com/apis/credentials (เปิดใช้ Google Sheets API ก่อน)
GOOGLE_SHEETS_API_KEY=

# ─── Supabase (ฐานข้อมูลหลังบ้านของหน้าแอดมิน) ─────────────────────────────
# หน้าแอดมินอ่านข้อมูลจาก Supabase schema `app`; ระบบบัญชีแดชบอร์ดใช้ schema `dashboard` ของโปรเจกต์เดียวกัน
# ต้องเพิ่ม schema `app` ใน Supabase → Settings → API → Exposed schemas ก่อน
SUPABASE_URL=
# service-role key เป็นความลับ — ใช้ฝั่งเซิร์ฟเวอร์เท่านั้น ห้ามขึ้นต้นด้วย NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
# (ไม่บังคับ) ชื่อ schema ค่าเริ่มต้น app
SUPABASE_DB_SCHEMA=app

# ─── ระบบบัญชีแดชบอร์ด (Supabase Auth + schema `dashboard`) ────────────────
# บัญชีแดชบอร์ดแยกจากผู้ใช้ LINE ของแอปจัดการขยะ — ตั้งค่าครั้งเดียว:
#   1) รัน supabase/dashboard_schema.sql ใน Supabase → SQL Editor
#   2) Settings → API → Exposed schemas: เพิ่ม `dashboard`
#   3) Authentication → Providers → Email: ปิด "Allow new users to sign up"
#   4) pnpm run create-root-admin you@example.com  (root admin คนแรก — ได้รับอีเมลแจ้งผู้สมัครใหม่)
#   ย้าย root ภายหลัง: pnpm run transfer-root new-root@example.com
# คีย์เซ็น cookie เซสชันและลิงก์ในอีเมล (อย่างน้อย 32 ตัวอักษร) สร้างด้วย: openssl rand -base64 48
# เปลี่ยนค่านี้ = ทุกคนต้องล็อกอินใหม่ และลิงก์ในอีเมลที่ส่งไปแล้วใช้ไม่ได้
DASHBOARD_SESSION_SECRET=
# URL ของแดชบอร์ด ใช้สร้างลิงก์ในอีเมล (ไม่มี / ท้าย) — บน production ต้องตั้ง
APP_BASE_URL=

# ─── อีเมล (Gmail SMTP) ──────────────────────────────────────────────────────
# บัญชี Gmail ที่ใช้ส่ง + App password (Google Account → Security → 2-Step Verification → App passwords)
# ถ้าเว้นว่าง ระบบยังทำงานได้แต่จะไม่ส่งอีเมล (สมัคร/อนุมัติ/ลืมรหัสผ่าน)
GMAIL_USER=
GMAIL_APP_PASSWORD=
